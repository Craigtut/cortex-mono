{
  // Typechecks this package's tests, which tsconfig.json deliberately does
  // not: its `exclude` lists "tests", so `npm run typecheck` has never seen
  // a single test file in this repo. That is why a test harness can annotate
  // a hand-built collaborator with a production interface, omit a required
  // member, and have the annotation enforce nothing.
  //
  // Run through `npm run typecheck:tests` from the root. NOT part of
  // `typecheck` and NOT a CI gate: it is expected to be red today, and a red
  // step nobody can fix teaches people to ignore the ones that matter.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*"],
  // `exclude` is inherited and beats `include`, so dropping "tests" here is
  // the whole point of the file. Leaving it out reports a clean zero over an
  // empty program, which is how this gap stayed invisible.
  "exclude": ["node_modules", "dist"]
}
