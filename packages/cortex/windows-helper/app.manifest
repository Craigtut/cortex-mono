<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for the Tier-1 sandbox helper.

  - requestedExecutionLevel asInvoker: the helper is UNELEVATED by design. It
    must never trigger a UAC prompt; it restricts its own token downward, which
    needs no elevation. (Tier 2's WFP network enforcement is a separate, opt-in
    elevated setup component, not this binary.)
  - longPathAware: workspace paths can exceed MAX_PATH; opt into long paths so
    ACL and CreateProcess calls do not truncate.
  - activeCodePage UTF-8: keep argv/env/path handling consistent with the UTF-8
    the Node parent emits.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
