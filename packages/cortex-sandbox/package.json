{
  "name": "@animus-labs/cortex-sandbox",
  "version": "0.1.0",
  "description": "OS-level sandbox provider for @animus-labs/cortex (macOS Seatbelt, Linux bubblewrap) built on @anthropic-ai/sandbox-runtime",
  "license": "MIT",
  "author": "Animus Labs",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Craigtut/cortex-mono.git",
    "directory": "packages/cortex-sandbox"
  },
  "bugs": {
    "url": "https://github.com/Craigtut/cortex-mono/issues"
  },
  "homepage": "https://github.com/Craigtut/cortex-mono/tree/main/packages/cortex-sandbox",
  "keywords": [
    "cortex",
    "sandbox",
    "seatbelt",
    "bubblewrap",
    "security",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "vendor",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "npm run build",
    "//build:helper:win": "Windows-only. Builds and (separately) signs the Tier-1 sandbox helper. NOT part of `build`: the JS install never requires a Rust toolchain. The signed exe is prebuilt on Windows CI and shipped in vendor/win32-x64. See docs/cortex/windows-sandbox-build.md.",
    "build:helper:win": "cargo build --release --manifest-path windows-helper/Cargo.toml --target x86_64-pc-windows-msvc",
    "test:helper:win": "cargo test --manifest-path windows-helper/Cargo.toml --target x86_64-pc-windows-msvc"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.63"
  },
  "peerDependencies": {
    "@animus-labs/cortex": "^0.6.0"
  },
  "devDependencies": {
    "@animus-labs/cortex": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
